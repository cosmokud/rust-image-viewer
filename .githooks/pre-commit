#!/bin/sh
# The gate that is about the change itself, run before a commit exists: the tree is what
# rustfmt writes. It is cheap against a build that is already there -- a formatting check is
# 1.5 s -- so a commit never waits on a compile that costs minutes.
#
# Clippy is left out on purpose: the tree carries 152 clippy diagnostics across 10 files, so
# a `-D warnings` gate would be bypassed rather than obeyed until those are cleared.
#
# It runs no test, on purpose. The path guard is pre-push's, and the suite belongs to the
# workflows: a guard that reads source and compiles nothing cannot hang, and a hook that
# can hang is a hook that gets bypassed.
#
# RIV_SKIP_PRECOMMIT=1 skips it, for a commit made on a machine that has already answered
# it. Neither pre-push nor prepare-commit-msg is skipped by it.

set -eu

if [ "${RIV_SKIP_PRECOMMIT:-}" = 1 ]; then
  echo "RIV_SKIP_PRECOMMIT=1: formatting is not checked for this commit." >&2
  echo "Nothing else is skipped: pre-push still reads the tracked tree." >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

if ! cargo fmt --all -- --check; then
  echo "" >&2
  echo "The commit is stopped: rustfmt would rewrite what is above." >&2
  echo "Fix it with" >&2
  echo "" >&2
  echo "  cargo fmt --all" >&2
  echo "" >&2
  echo "then stage what it rewrote and commit again." >&2
  exit 1
fi
echo "pre-commit: formatting checked"
